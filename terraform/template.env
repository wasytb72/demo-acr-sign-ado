# ===== Terraform Service Principal Authentication =====
# NEVER commit this file to Git or share it. Restrict permissions with:
# chmod 600 .env

# Azure Active Directory Tenant
ARM_TENANT_ID="<TENANT_ID>"

# Azure Subscription
ARM_SUBSCRIPTION_ID="<SUBSCRIPTION_ID>"

# Service Principal Credentials
ARM_CLIENT_ID="<APP_ID>"             # Also called: applicationId
ARM_CLIENT_SECRET="<CLIENT_SECRET>"  # Never echo or log this

# Optional: Enable Azure CLI backend auth
# ARM_USE_MSI="false"

# Optional: Default Azure Location for Terraform
# ARM_LOCATION="westeurope"